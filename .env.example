# 行迹 Trip 后端环境变量示例
# 复制为 .env 后按需填写；.env 含真实密钥且已被 .gitignore 忽略，不要提交。
# SMTP 未配置时服务仍可启动，注册/找回等接口会返回 email_sent=false。

# --- 高德地图 ---
# Web 服务 Key：只在后端调用，用于地点搜索、详情与路线
AMAP_WEB_KEY=
# JS API Key 与安全密钥：会下发到浏览器，按高德控制台配置安全域名
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# --- 模型服务 ---
# 兼容 OpenAI Chat Completions 的企业网关；留空则使用 DEEPSEEK_API_KEY
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 未配置企业网关时使用
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# --- 邮件 SMTP ---
SMTP_HOST=
# 默认端口：ssl 用 465，starttls 用 587，none 用 25
SMTP_PORT=587
# ssl | starttls | none；none 仅限本地调试，生产必须用 ssl 或 starttls
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# 发件地址，需与认证账号匹配或已获授权
SMTP_FROM=
SMTP_FROM_NAME=行迹 Trip

# --- 数据库 ---
# 生产：PostgreSQL 16 + psycopg3（postgresql+psycopg://user:password@host:5432/dbname）
# 本地开发/测试可不填，回退到 sqlite:///./trip.db；APP_ENV=production 时禁止 SQLite
# DATABASE_URL=postgresql+psycopg://trip:change-me@127.0.0.1:5432/trip

# --- Redis（可选，多 worker 时启用）---
# 配置后限流、匿名日配额、实时在线名单跨 worker 共享；留空则回退进程内实现
# REDIS_URL=redis://127.0.0.1:6379/0

# --- 站点 ---
# 邮件链接前缀，生产填 https 域名，不带结尾斜杠
APP_BASE_URL=http://127.0.0.1:8000
# development | production
APP_ENV=development
# 客服/反馈邮箱；留空时前端隐藏反馈入口，公开上线前必须填写
SUPPORT_EMAIL=

# --- 运营主体（服务条款/隐私政策展示）---
# 未配置 OPERATOR_NAME 时页面保持「演示版」文案；配置后页脚展示真实主体
# 联系邮箱格式不合法时不会下发；管辖地按法务确认填写
OPERATOR_NAME=
OPERATOR_CONTACT_EMAIL=
OPERATOR_JURISDICTION=
ICP_NUMBER=
# 运营端点（举报列表/处置、/api/metrics）的 X-Admin-Token；留空时这些端点返回 404
# 生产必须设置 32 位以上随机值，只通过本机或内网探针携带
ADMIN_TOKEN=

# --- 本机告警检查（scripts/check_alerts.py）---
# /api/metrics 地址；本机 cron 用默认 8000 即可，跨机探针填内网地址
METRICS_URL=http://127.0.0.1:8000/api/metrics
# 群机器人 webhook；留空时只打印告警不推送。URL 本身是密钥，不要提交
ALERT_WEBHOOK_URL=
# generic | dingtalk | feishu | slack
ALERT_WEBHOOK_TYPE=generic
# 部署名，会写进告警标题，如 trip-prod
ALERT_INSTANCE=
# 采样状态文件，默认项目根 .tmp-alert-state.json，只存计数器
# ALERT_STATE_FILE=

# --- 外部可用性检查（scripts/check_uptime.py）---
# 从外部机器访问的公开地址，建议 https://<域名>/api/health
UPTIME_URL=
# 证书剩余天数阈值（脚本参数，不在这里配置）：默认 14 天警告、7 天严重

# --- 上线自检（scripts/launch_preflight.py）---
# psql 可执行文件路径；默认从 PATH 找 psql，部署机装法不同时可填绝对路径
# PSQL_BIN=

# --- 会话与安全 ---
# 生产必须设置为 32 字节以上随机值：APP_ENV=production 且留空时会拒绝启动，避免多 worker/重启后登录态随机失效
# 本地开发留空时会写仓库根 .session-secret（0600）复用；只读文件系统才退回进程内随机密钥
SESSION_SECRET=
# 开发 false；生产留空（按 APP_BASE_URL=https 自动开启）或写 true。
# 其它值（1/0/no/yes 等）在 production 会直接拒绝启动，避免误以为已开启 Secure。
COOKIE_SECURE=false
# 登录防爆破：同一账号连续失败次数达到上限后锁定；锁定期间即使密码正确也拒绝登录
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_SECONDS=900

# --- 匿名日配额（0 表示关闭该 scope 的配额）---
ANON_LLM_DAILY=30
ANON_AMAP_DAILY=300

# --- 容量与重试（一般无需修改）---
# SQLite 写锁等待。连接池默认值按方言区分：
# PostgreSQL 5+5、排队 10s；SQLite 10+20、排队 15s；下方变量可覆盖两者。
SQLITE_BUSY_TIMEOUT_MS=5000
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10
# 出站 HTTP 连接上限（高德等）
HTTP_MAX_CONNECTIONS=120
HTTP_MAX_KEEPALIVE=40
# 高德地点详情缓存秒数与条数
AMAP_PLACE_CACHE_SECONDS=300
AMAP_PLACE_CACHE_MAX=2000
# 模型并发闸门、排队超时与失败重试
LLM_MAX_CONCURRENCY=4
LLM_QUEUE_TIMEOUT_SECONDS=8
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.6
# 单个请求体上限（字节），默认 2 MiB；0 表示关闭，超限直接回 413
REQUEST_MAX_BODY_BYTES=2097152
# 实时协同的版本轮询间隔（秒）：每个在线房间每轮一次轻量查库
LIVE_POLL_SECONDS=1.5

# --- 调试开关（生产不要开启）---
# 设为 1/true/yes 时关闭令牌桶限流；匿名日配额仍独立生效
# RATE_LIMIT_DISABLED=0

# --- 模型上下文压缩（harness，一般无需修改）---
# HARNESS_CONTEXT_WINDOW=64000
# HARNESS_COMPACT_RATIO=0.6
# HARNESS_COMPACT_TURNS=8
# HARNESS_COMPACT_MESSAGES=12
# HARNESS_MAX_HISTORY=24
# HARNESS_MEMORY_EVERY_N_TURNS=4
# HARNESS_MEMORY_MIN_TURN=2
# HARNESS_PLAN_TICK_SECONDS=5